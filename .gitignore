# =========================
# Python 관련 파일 제외
# =========================

# 파이썬 캐시 폴더
__pycache__/
*.py[cod]
*$py.class

# 가상환경 폴더
.venv/
venv/
env/

# 파이썬 패키지 빌드 결과
build/
dist/
*.egg-info/


# =========================
# ROS2 빌드 결과 제외
# =========================

# colcon build 결과물
install/
log/
build/

# ROS2 실행 로그
.ros/


# =========================
# Gazebo / 시뮬레이터 관련 파일 제외
# =========================

# Gazebo 캐시 및 로그
.gazebo/
*.log


# =========================
# rosbag 대용량 파일 제외
# =========================

# rosbag2 기록 파일은 용량이 커질 수 있으므로 기본적으로 GitHub에 올리지 않음
rosbags/**/*.db3
rosbags/**/*.mcap
rosbags/**/*.yaml

# 폴더 구조 유지를 위한 .gitkeep 파일은 허용
!rosbags/**/.gitkeep


# =========================
# 결과물 중 대용량 파일 제외
# =========================

# 영상 파일
results/**/*.mp4
results/**/*.mov
results/**/*.avi

# 대용량 로그 파일
results/**/*.log

# 결과 요약 문서와 표는 GitHub에 올림
!results/**/*.md
!results/**/*.csv
!results/**/.gitkeep


# =========================
# 환경변수 / 비밀키 제외
# =========================

# OpenAI API Key, 토큰, 비밀번호가 들어갈 수 있으므로 절대 올리지 않음
.env
.env.*
*.pem
*.key


# =========================
# 운영체제 / 에디터 파일 제외
# =========================

# macOS 파일
.DS_Store

# VS Code 개인 설정
.vscode/

# JetBrains IDE 설정
.idea/


# =========================
# Jupyter Notebook 관련
# =========================

.ipynb_checkpoints/